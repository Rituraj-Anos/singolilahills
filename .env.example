# Copy to .env.local for local work. On the host (Cloudflare, Vercel, etc.) set the same names in the project settings.

# Public site address, no trailing slash. Used for sitemap, canonical links and share previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Fallback WhatsApp number (country code + digits, no + or spaces). The admin "Site settings" value wins once saved.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Lets the enquiry form save leads that the public cannot read.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email the owner on every new enquiry (resend.com, free tier is enough)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Website <onboarding@resend.dev>
