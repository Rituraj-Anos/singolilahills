# Copy this file to .env.local for local work (the real values stay on your computer and are never committed).
# On the host (Vercel), add the same names and values under Settings > Environment Variables.
# Full walkthrough: ADMIN-GUIDE.md, section "Connect the site to Supabase".

# --- Supabase: dashboard > your project > Settings > API Keys (or the green Connect button) ---
# Project URL, looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key", starts with sb_publishable_ . Safe to be public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key", starts with sb_secret_ . PRIVATE: server only, never share it, never put NEXT_PUBLIC_ in front of it.
# It lets the enquiry, review and newsletter forms save data that visitors themselves cannot read.
SUPABASE_SECRET_KEY=
# (Older projects may still show "anon" and "service_role" keys. Those work too, under the names
#  NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.)

# --- Your public website address, no slash at the end. Leave empty while working locally. ---
NEXT_PUBLIC_SITE_URL=

# --- WhatsApp number: country code + digits, no + or spaces, e.g. 919830012345 ---
# The number saved in the admin under Site settings takes priority once it is filled in.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Optional: email the owner on every new enquiry or review (free account at resend.com) ---
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Website <onboarding@resend.dev>
